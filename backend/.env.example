PORT=5000
# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=steeltrack_erp
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/steeltrack_erp
JWT_ACCESS_SECRET=your_very_long_and_random_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_very_long_and_random_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
NODE_ENV=development
CLIENT_URL=http://localhost:5173